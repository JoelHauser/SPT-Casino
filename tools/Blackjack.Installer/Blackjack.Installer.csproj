<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Blackjack.Installer</RootNamespace>
    <AssemblyName>Blackjack_V1.0.3</AssemblyName>
    <Version>1.0.3</Version>

    <!--
      Self-contained, so it runs on a machine with no .NET installed. SPT ships its
      own runtime rather than installing one system-wide, so assuming a shared
      runtime is exactly the assumption that fails on someone else's PC.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    The mod itself, carried inside the executable. Staged by
    tools/build-installer.py, which builds both halves and zips them relative to
    the SPT folder. Without that file this project fails to compile, which is
    deliberate: an installer with nothing inside it is worse than no installer.
  -->
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
