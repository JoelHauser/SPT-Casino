<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The stacked shoe stays internal: only a shuffled one may deal a real round.
         The tests need it to force a tie, and the server tests to force a war. -->
    <InternalsVisibleTo Include="War.Game.Tests" />
    <InternalsVisibleTo Include="War.Server" />
    <InternalsVisibleTo Include="War.Server.Tests" />
  </ItemGroup>

</Project>
