<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Roulette.Server</RootNamespace>
    <AssemblyName>Roulette.Server</AssemblyName>

    <!-- Must match ModMetadata.Version. Two places, and they have to agree. -->
    <Version>0.1.0</Version>

    <!-- SPT loads the mod from user/mods/Roulette, and provides its own assemblies. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.0.x backport: pinned to the exact server version this branch targets. -->
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.13">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <ProjectReference Include="..\Roulette.Game\Roulette.Game.csproj" />
    <ProjectReference Include="..\Casino.Server\Casino.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="roulette.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
