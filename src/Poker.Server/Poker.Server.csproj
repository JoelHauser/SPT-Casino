<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Poker.Server</RootNamespace>
    <AssemblyName>Poker.Server</AssemblyName>

    <!-- Must match ModMetadata.Version. Two places, and they have to agree. -->
    <Version>1.0.2</Version>

    <!-- SPT loads the mod from user/mods/Poker, and provides its own assemblies. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NuGet tops out at 4.1.2 while the install is 4.1.3. Verified safe on Blackjack
      across 36 types and 63 members: nothing this mod touches moved between them.
    -->
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <ProjectReference Include="..\Poker.Game\Poker.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
